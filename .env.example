# LifeSure AI — Environment Configuration
# Backend Settings
PROJECT_NAME="LifeSure AI — Intelligent Life Insurance Needs Finder"
VERSION="1.0.0"
API_PREFIX="/api"

# Database: Defaults to local SQLite for instant zero-dependency execution.
# To use PostgreSQL in production, set:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/lifesure"
DATABASE_URL="sqlite:///./lifesure.db"

# Admin Secret Key for platform administrative operations
ADMIN_SECRET_KEY="lifesure-admin-key-2026"

# Frontend Vite API URL (Optional, defaults to http://127.0.0.1:8000/api)
VITE_API_URL="http://127.0.0.1:8000/api"
