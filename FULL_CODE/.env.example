# LifeWise — Environment Configuration
# Backend Settings
PROJECT_NAME="LifeWise — Intelligent Life Insurance Needs Finder & Digital Advisory Platform"
VERSION="1.0.0"
API_PREFIX="/api"

# Database: Defaults to local SQLite for instant zero-dependency execution.
# To use PostgreSQL in production, set:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/lifewise"
DATABASE_URL="sqlite:///./lifewise.db"

# Admin Secret Key for platform administrative operations
ADMIN_SECRET_KEY="lifewise-admin-key-2026"
ADMIN_INITIAL_ID="ADMIN001"
ADMIN_INITIAL_PASSWORD="CHANGE_ME_IN_PRODUCTION"

# Frontend Vite API URL (Optional, defaults to http://127.0.0.1:8000/api)
VITE_API_URL="http://127.0.0.1:8000/api"
